GEMINI_API_KEY=your_api_key_here

# Optional: override the default Gemini model
# GEMINI_MODEL=gemini-3.6-flash

# Optional: override the Gemini text-to-speech model/voice used for
# "Listen to explanation" audio (Phase 5). No separate API key is needed -
# TTS reuses GEMINI_API_KEY above.
# TTS_MODEL=gemini-3.1-flash-tts-preview
# TTS_VOICE=Kore
